  "rules": {
    "ballot": {
      "aboveTheLine": {
        "firstPreferenceMark": 1,
        "tickOrCrossTreatedAsFirstPreference": true,
        "minimumRegisteredGroupVotingTickets": 1,
        "maximumRegisteredGroupVotingTickets": 3,
        "ticketAllocation": "equal shares; any one- or two-ballot remainder is assigned by lot as prescribed in section 112B"
      },
      "belowTheLine": {
        "minimumConsecutivePreferences": 5,
        "sequenceStartsAt": 1,
        "countedUntilFirstBreak": true
      },
      "validAboveAndBelowLineMarking": "below-the-line preferences prevail",
      "onlyOneMethodValid": "the valid method prevails"
    },
    "quota": {
      "formula": "floor(firstPreferenceVotes / (vacancies + 1)) + 1",
      "firstPreferenceVotesMeaning": "total formal first preference votes in the region",
      "candidateElectedAtOrAboveQuota": true
    },
    "surplusTransfer": {
      "surplusFormula": "candidateVotes - quota",
      "transferValueFormula": "surplusVotes / ballotPapersTreatedAsFirstPreferenceForElectedCandidate",
      "nextAvailablePreference": true,
      "parcelCreditFormula": "floor(ballotPapersInParcel * transferValue)",
      "allBallotPapersInParcelMove": true,
      "candidateStopsReceivingAfterElectionDuringTransfer": true,
      "transferredBallotsRetainedAsCandidateFirstPreferenceForLaterSurplus": true
    },
    "exclusionTransfer": {
      "trigger": "after first preferences or completed surplus transfers, fewer candidates than required have reached quota",
      "exclude": "continuing candidate with fewest votes",
      "originalBallotsTransferValue": 1,
      "transferredParcelOrder": "highest transfer value to lowest transfer value",
      "parcelCreditFormula": "floor(ballotPapersInParcel * retainedTransferValue)",
      "completeCurrentExclusionBeforeNewSurplus": true,
      "stopFurtherParcelsToCandidateAfterElection": true
    },
    "orderingAndTies": {
      "surplusOrder": "largest surplus first; equal surpluses use the last count with different totals; earlier-created surplus precedes later-created surplus",
      "equalLowestExclusion": "exclude the candidate with fewer votes at the last count where totals differed; otherwise decide by lot",
      "finalEqualTotals": "decide by lot"
    },
    "termination": {
      "lastVacancyTwoCandidates": "elect the candidate with the larger total even below quota",
      "continuingCandidatesEqualVacancies": "declare every continuing candidate elected",
      "exactQuotaBallots": "set aside as finally dealt with"
    },
    "exhaustedBallots": "ballot papers without a next available preference do not credit a continuing candidate"
