  ],
  "comparators": {
    "uniform-swing-baseline": {
      "uses": ["historical-replay-2014-assembly-notional-baseline.csv", "historical-replay-2014-poll-observations.json", "historical-replay-2014-ballot-mask.csv"],
      "excludes": ["historical_2014_crosswalk_core_features_long.csv", "historical-replay-2014-local-inputs.csv", "district shocks", "Council"],
      "definition": "pre-election notional major-party district baseline plus common statewide poll movement",
      "metricAvailability": ["major-party-event-probability", "winner"]
    },
    "polling-only": {
      "uses": ["historical-replay-2014-poll-observations.json", "historical-replay-2014-ballot-mask.csv"],
      "excludes": ["historical-replay-2014-assembly-notional-baseline.csv", "historical-replay-2014-local-inputs.csv", "district shocks", "Council"],
      "definition": "frozen statewide polling state with ballot masks and no local geography",
      "metricAvailability": ["statewide-primary", "district-primary", "winner-where-defined"]
    },
    "polling-plus-fundamentals": {
      "uses": ["historical-replay-2014-poll-observations.json", "historical-replay-2014-assembly-notional-baseline.csv", "historical-replay-2014-local-inputs.csv", "historical-replay-2014-ballot-mask.csv"],
      "excludes": ["district shocks", "correlated chamber ensemble", "Council"],
      "definition": "deterministic statewide polling plus notional baseline and prediction-safe local fundamentals",
      "metricAvailability": ["statewide-primary", "district-primary", "winner-where-defined"]
    },
    "seat-level-model": {
      "uses": ["historical-replay-2014-poll-observations.json", "historical-replay-2014-local-inputs.csv", "historical-replay-2014-ballot-mask.csv", "fixed pre-score district uncertainty"],
      "excludes": ["shared cross-seat correlation", "complete chamber ensemble", "Council"],
      "definition": "independent district IRV marginals with fixed pre-score uncertainty and broad preference fallback",
      "metricAvailability": ["district-primary", "winner", "seat-count-approximation"]
    },
    "complete-ensemble": {
      "uses": ["immutable historical-replay-2014-v2-prediction.json"],
      "definition": "reference to the sealed certifying v2 prediction; never regenerated by comparator scoring",
      "metricAvailability": ["statewide-primary", "district-primary", "winner", "final-pair", "Assembly-chamber", "Council"]
    }
  }
}
